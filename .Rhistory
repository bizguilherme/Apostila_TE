gl1 <- 10
gl2 <- 10
alpha <- 0.05
x <- seq(0, 5, length = 1000)
y <- df(x, gl1, gl2)
Fcrit <- qf(1 - alpha, gl1, gl2)
plot(x, y, type = "l", lwd = 2,
xlab = "F", ylab = "f(F)")
# Região crítica
polygon(c(Fcrit, x[x >= Fcrit], max(x)),
c(0, y[x >= Fcrit], 0))
abline(v = Fcrit, lty = 2)
# Texto matemático
text(Fcrit, max(y)*0.7,
labels = expression(F[alpha]),
pos = 4)
