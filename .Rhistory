resp=scan(dec=",",nmax = 25)
trat=rep(LETTERS[1:5],each=5)
AgroR::DIC(trat,resp,mcomp = "tukey")
AgroR::dunnett(trat,resp,control="E")
library(readxl)
dados <- read_excel("~/Downloads/dados_germ.xlsx")
View(dados)
dados$Ganho_Germ = dados$Germf- dados$Germi
## estatistica descritiva
mediag= tapply(dados$Ganho_Germ, dados$Trat, mean)
mediag
boxplot(dados$Ganho_Germ ~ dados$Trat)
points(mediag,pch=8,col="red")
## Modelo Estatístico
mod=aov(dados$Ganho_Germ~dados$Trat)
# Normalidade dos erros, resultado acima de 0,05 é normal
shapiro.test(mod$residuals)
nortest::lillie.test(mod$res)
plot(mod$residuals)
hnp::hnp(mod)
# Homogeneidade, resultado acima de 0,05 é normal
bartlett.test(mod$residuals~dados$Trat)
car::leveneTest(mod$residuals~dados$Trat)
# Teste de independência
lmtest::dwtest(mod)
## ANOVA, neste exemplo, o resultado foi significativo a 1%, ou seja,  o pvalor é baixo
anova(mod)
AgroR::DIC(dados$Trat, dados$Ganho_Germ)
## estatistica descritiva
mediast=tapply(dados$Comp,dados$Trat,mean)
mediast
boxplot(dados$Comp~dados$Trat)
points(mediast,pch=8,col="red")
## Modelo Estatístico
mod=aov(dados$Comp~dados$Trat)
# Normalidade dos erros, resultado acima de 0,05 é normal
shapiro.test(mod$residuals)
nortest::lillie.test(mod$res)
plot(mod$residuals)
hnp::hnp(mod)
# Homogeneidade, resultado acima de 0,05 é normal
bartlett.test(mod$residuals~dados$Trat)
car::leveneTest(mod$residuals~dados$Trat)
# Teste de independência
lmtest::dwtest(mod)
## ANOVA, neste exemplo, o resultado foi significativo a 1%, ou seja,  o pvalor é baixo
anova(mod)
AgroR::DIC(dados$Trat, dados$Comp)
## Transformação Box & Cox
MASS::boxcox(dados$Comp~dados$Trat,lambda=seq(-2,5,.1))
dados$Comp_transf = (dados$Comp^1.5 - 1) / 1.5
mediat=tapply(dados$Comp_transf,dados$Trat,mean)
mediat
## Novo modelo estatístico
modt = aov(Comp_transf ~ Trat, data = dados)
summary(modt)
# Normalidade
shapiro.test(modt$residuals)
# Independência
lmtest::dwtest(modt)
# Teste não paramétrico
require(agricolae)
car::leveneTest(mod$residuals~dados$Trat)
